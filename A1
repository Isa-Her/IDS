--Consultar los productos con sus marcas y sus categorías.--
SELECT
P.Id,
P.Descripcion AS Producto,
P.Precio,
P.Cantidad,
C.Descripcion AS Categoria,
M.Descripcion AS Marca
FROM Productos P
INNER JOIN Categorias C
ON P.IdCategoria = C.Id
INNER JOIN Marcas M
ON P.IdMarca = M.Id;

--Consultar los carritos con sus carritos detalle y sus productos.--
SELECT
CA.FolioVenta,
CA.Fecha,
P.Descripcion AS Producto,
CD.Cantidad,
CD.Subtotal
FROM Carrito CA
INNER JOIN CarritoDetalle CD
ON CA.Id = CD.IdCarrito
INNER JOIN Productos P
ON CD.IdProducto = P.Id;

--Consultar los carritos con sus carritos detalle y sus productos y sus marcas y categorías.--
SELECT
CA.FolioVenta,
CA.Fecha,
P.Descripcion AS Producto,
M.Descripcion AS Marca,
C.Descripcion AS Categoria,
CD.Cantidad,
CD.Subtotal
FROM Carrito CA
INNER JOIN CarritoDetalle CD
ON CA.Id = CD.IdCarrito
INNER JOIN Productos P
ON CD.IdProducto = P.Id
INNER JOIN Marcas M
ON P.IdMarca = M.Id
INNER JOIN Categorias C
ON P.IdCategoria = C.Id;
